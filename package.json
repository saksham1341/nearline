{
  "name": "nearline",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run typecheck",
    "build:web": "esbuild apps/web/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "dev": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "h3-js": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20"
  }
}
